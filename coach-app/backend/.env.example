APP_ENV=dev
APP_HOST=0.0.0.0
# 后端监听端口（本地开发 uvicorn 使用；Docker 宿主机映射在 coach-app/.env 的 BACKEND_PORT）
APP_PORT=8000
APP_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

DATA_DIR=/app/data
DATABASE_URL=sqlite:////app/data/coach_app.db
RESOURCES_DIR=/app/resources

QDRANT_URL=http://shared-qdrant:6333
QDRANT_COLLECTION=coach_chunks

OPENROUTER_API_KEY=
LLMS_CONFIG_PATH=config/llms.local.json
# 推荐把模型与 provider 配置写到 llms.local.json（支持热加载）；以下为兜底值
OPENROUTER_CHAT_MODEL=openai/gpt-4.1-mini
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_AUDIO_MODEL=openai/gpt-4o-mini-transcribe
OPENROUTER_VISION_MODEL=openai/gpt-4.1-mini
OPENROUTER_TIMEOUT_SECONDS=45
OPENROUTER_EXPERIENCE_OCR_PROVIDER_ORDER=
OPENROUTER_EXPERIENCE_EXTRACT_PROVIDER_ORDER=
OPENROUTER_PROVIDER_ORDER=
OPENROUTER_ALLOW_FALLBACKS=true
OPENROUTER_PROVIDER_SORT=price
EXPERIENCE_OCR_MODEL=openai/gpt-4.1-mini
EXPERIENCE_EXTRACT_MODEL=openai/gpt-4.1-mini

PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
PERPLEXITY_TIMEOUT_SECONDS=35

JINA_API_KEY=
JINA_READER_BASE_URL=https://r.jina.ai
JINA_TIMEOUT_SECONDS=20

RETRIEVAL_TOP_K=6
CHUNK_SIZE=1200
CHUNK_OVERLAP=180

QDRANT_EXPERIENCE_COLLECTION=coach_experience_questions
EXPERIENCE_CLUSTER_THRESHOLD=0.84
EXPERIENCE_BATCH_MAX_FILES=20
EXPERIENCE_MAX_IMAGE_MB=8
EXPERIENCE_HOT_DEFAULT_DAYS=180
EXPERIENCE_SLICE_HEIGHT=2200
EXPERIENCE_SLICE_OVERLAP=240
EXPERIENCE_SLICE_THRESHOLD=2600
